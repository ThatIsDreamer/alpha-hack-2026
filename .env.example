AI_API_KEY=alpha-key-here
AI_BASE_URL=https://changellenge.up.railway.app/v1

# Must support Chat Completions with strict JSON schema output.
AI_MODEL=gpt-4o-mini
# Alternatively use OPENAI_API_KEY and omit AI_BASE_URL for OpenAI directly.
# NEWS_DB=/absolute/path/to/news.sqlite3

# Parallel marking requests (1–20); per-run limits still apply.
AI_CONCURRENCY=5
